JWT_SECRET=replace-with-a-unique-random-secret
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require
GEOAPIFY_API_KEY=your_geoapify_key
# Optional city/region/country suffix to make venue geocoding more precise.
CAMPUS_GEOCODING_CONTEXT=
# Public origin used for email links and OAuth callbacks.
APP_BASE_URL=http://localhost:3000
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=CampusHub <no-reply@example.com>
# Google Cloud OAuth web client; authorize redirect URI must match exactly.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Microsoft Entra app registration; choose personal + organizational accounts.
MICROSOFT_CLIENT_ID=replace-with-microsoft-application-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-client-secret
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common/v2.0
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
# Local SQLite fallback for development only. Vercel production requires DATABASE_URL.
# DB_PATH=campus.db
